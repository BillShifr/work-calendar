VCS_REF=0000000000000000000000000000000000000000
APP_IMAGE_REPOSITORY=docker.io/billshifr/tfoms-time
MIGRATOR_IMAGE_REPOSITORY=docker.io/billshifr/tfoms-time-migrator
POSTGRES_DB=tfoms_time
POSTGRES_USER=tfoms_time
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
CONTAINER_DATABASE_URL=postgres://tfoms_time:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/tfoms_time
APP_PORT=3080
APP_ORIGIN=https://time.tfoms
SESSION_COOKIE_SECURE=true
INITIAL_ADMIN_LOGIN=hr
INITIAL_ADMIN_NAME=REPLACE_WITH_REAL_HR_ADMIN_NAME
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_16_PLUS_CHARACTER_SECRET
BACKUP_RESTORE_LOCK_FILE=/tmp/tfoms-time-backup-restore.lock
